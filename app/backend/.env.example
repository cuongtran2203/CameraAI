# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/camera_analyst
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/camera_analyst

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Secret Key (generate a random string for production)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=8000

# Gemini API Configuration
GEMINI_API_KEY = 
GEMINI_MODEL=gemini-2.5-flash

# =====================================================
# AI Service (Food Image Matching)
# =====================================================
# URL of the AI service that handles image comparison
# - Local dev: http://localhost:8000
# - Docker:    http://ai_service:8000 (internal container network)
AI_SERVICE_URL=http://localhost:8000

# Path prefix for AI service images
IMAGE_BASE_PATH=/home/cuongtdm/Documents/tructt/service/CameraAI/app/backend/app/ai_service
